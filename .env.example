# Server
PORT=3000
# Public base URL used to build Stripe success/cancel redirect links.
# In production set this to your real domain, e.g. https://reconcilia.com
PUBLIC_BASE_URL=http://localhost:3000

# Postgres connection string. Locally, point this at your own Postgres instance.
# On Vercel, add the Postgres integration (Storage tab) and it sets this for you
# automatically (as POSTGRES_URL) - in that case you can leave DATABASE_URL unset.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# Stripe (get these from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=REPLACE_WITH_YOUR_STRIPE_SECRET_KEY
# Publishable key (also on that same page) - safe to expose to the browser,
# it's what powers the embedded card form (Stripe Elements) in the last checkout step.
STRIPE_PUBLISHABLE_KEY=REPLACE_WITH_YOUR_STRIPE_PUBLISHABLE_KEY
# Created by `stripe listen --forward-to localhost:3000/api/webhook` locally,
# or from the Stripe Dashboard webhook settings in production.
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_YOUR_STRIPE_WEBHOOK_SECRET

# Admin panel login (basic auth) - change these before deploying
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-please

# Meta Pixel + Conversions API (from Meta Events Manager > Data Sources > your pixel)
# META_PIXEL_ID is not secret - it's sent to the browser via /api/config to load
# the Pixel. Leave both unset to skip Meta tracking entirely.
META_PIXEL_ID=REPLACE_WITH_YOUR_META_PIXEL_ID
# Settings > Conversions API > Generate access token. This one IS secret - it's
# only ever used server-side to send events (AddPaymentInfo, Purchase).
META_ACCESS_TOKEN=REPLACE_WITH_YOUR_META_CAPI_ACCESS_TOKEN
# Optional: Test Events tool's code, to see events arrive live while testing.
# Remove it once you've verified events and are ready to track real traffic.
META_TEST_EVENT_CODE=

# Resend (https://resend.com/api-keys) - powers the order-confirmation email
# and the delivery-status emails sent when you update an order in /admin.
# Leave unset to skip emails entirely; everything else keeps working.
RESEND_API_KEY=REPLACE_WITH_YOUR_RESEND_API_KEY
# Must be on a domain you've verified in Resend (Domains tab). Until you
# verify one, Resend's own onboarding@resend.dev works for testing, but can
# only send to the email address on your Resend account.
RESEND_FROM_EMAIL=reconcilia <onboarding@resend.dev>
