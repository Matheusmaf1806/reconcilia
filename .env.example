# Server
PORT=3000
# Public base URL used to build Stripe success/cancel redirect links.
# In production set this to your real domain, e.g. https://reconcilia.com
PUBLIC_BASE_URL=http://localhost:3000

# Stripe (get these from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=REPLACE_WITH_YOUR_STRIPE_SECRET_KEY
# Created by `stripe listen --forward-to localhost:3000/api/webhook` locally,
# or from the Stripe Dashboard webhook settings in production.
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_YOUR_STRIPE_WEBHOOK_SECRET

# Admin panel login (basic auth) - change these before deploying
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-please
